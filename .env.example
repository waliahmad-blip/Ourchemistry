# ourchemistry.ai Environment Configuration

# Application URL
NEXT_PUBLIC_APP_URL="https://ourchemistry.ai"

# Database Configuration (PostgreSQL + pgvector for production, falls back to sovereign storage)
DATABASE_URL="postgresql://user:password@localhost:5432/ourchemistry"

# Authentication & Session Security
NEXTAUTH_SECRET="your-32-byte-hex-or-base64-secret-key"
NEXTAUTH_URL="https://ourchemistry.ai"

# Google OAuth Credentials (optional for development / pre-launch)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Engine & Vertex AI Sovereign Telemetry
VERTEX_PROJECT_ID="noorix-498112"
VERTEX_LOCATION="global"
VERTEX_KEY_JSON_PATH="C:\\Ourchemistry\\data\\vertex-key.json"
SOVEREIGN_MODEL_NAME="gemini-3.8-flash"
AI_BRAND_NAME="Astraea"
AI_GUARDRAIL_STRICT_MODE="true"

# Serverless & Deployment Settings
NODE_ENV="production"
PORT=3000
